# 环境变量配置示例
# 将此文件复制为 .env 并填入实际的 API 密钥

# OpenRouteService API 密钥（可选，备用路线服务）
# 注册地址: https://openrouteservice.org/dev/#/signup
# OPENROUTESERVICE_API_KEY=your_api_key_here

# Nominatim 联系邮箱（建议配置）
# 用于标识应用，遵守 Nominatim 使用政策
NOMINATIM_EMAIL=your_email@example.com

# 地图默认中心坐标（可选）
# 格式: 纬度,经度
# DEFAULT_CENTER=39.9042,116.4074

# 地图默认缩放级别（可选）
# DEFAULT_ZOOM=13
